{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic content package",
  "description": "One file per topic (content/<category>/<topicId>/data.json). Matches the topic ids used in the study-plan artifact's knowledge map, so a topic folder and a topic's db doc share the same id. Consumed by: (1) the Claude session syncing it into the artifact's db (item_state / topic_content collections) for interactive use, (2) later, a WordPress import script.",
  "type": "object",
  "required": [
    "topicId",
    "category"
  ],
  "properties": {
    "topicId": {
      "type": "string",
      "description": "Matches the subtopic id in the artifact's TOPICS taxonomy, e.g. 'rheum-sle'."
    },
    "category": {
      "type": "string",
      "description": "Matches the category id, e.g. 'rheum'."
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "flashcards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "front",
          "back"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "front": {
            "type": "string"
          },
          "back": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          }
        }
      }
    },
    "mcq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stem",
          "options",
          "correctIndex"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stem": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5
          },
          "correctIndex": {
            "type": "integer"
          },
          "explanation": {
            "type": "string"
          },
          "imageRef": {
            "$ref": "#/definitions/imageRef"
          },
          "imageAlt": {
            "type": "string"
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          },
          "optionExplanations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "draft",
              "reviewed"
            ],
            "description": "Draft authored clinical questions require final teacher review."
          }
        }
      }
    },
    "kfPmp": {
      "type": "array",
      "description": "Stepwise key-feature / patient-management-problem cases.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "vignette": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "prompt",
                "expectedAnswer"
              ],
              "properties": {
                "prompt": {
                  "type": "string"
                },
                "expectedAnswer": {
                  "type": "string"
                },
                "imageRef": {
                  "$ref": "#/definitions/imageRef"
                },
                "imageAlt": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "sourceRefs": {
                  "$ref": "#/definitions/sourceRefs"
                }
              }
            }
          },
          "imageRef": {
            "$ref": "#/definitions/imageRef"
          },
          "imageAlt": {
            "type": "string"
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caption"
        ],
        "properties": {
          "caption": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "description": "Link to the user's own private Drive file. Never a redistributable copy of copyrighted material."
          },
          "note": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "markdown"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "rowIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "legacyRowIndices": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          }
        }
      }
    },
    "lesson": {
      "type": "array",
      "description": "Narrative teaching content. A section contains stable paragraphs, an embedded module, or a group header.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading"
        ],
        "anyOf": [
          {
            "required": [
              "paragraphs"
            ]
          },
          {
            "required": [
              "body"
            ]
          },
          {
            "required": [
              "embedPath"
            ]
          },
          {
            "required": [
              "groupHeader"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "One or more paragraphs, separated by a blank line (\\n\\n)."
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/lessonParagraph"
            }
          },
          "embedPath": {
            "type": "string"
          },
          "embedNote": {
            "type": "string"
          },
          "groupHeader": {
            "type": "boolean"
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          }
        }
      }
    },
    "ventSim": {
      "type": "array",
      "description": "Disease-driven ventilator/BiPAP/CPAP decision-support scenarios — curated clinical guidance (initial settings, rationale, an example ABG/VBG, titration steps, common pitfalls), NOT a live physiological simulator with settings-driven gas-exchange computation. Rendered as its own learn-type tab ('شبیه‌سازی ونتیلاتور'), scoped in the app's JS to specific topicIds that opt in (currently only crit-vent) rather than shown for every topic.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "disease",
          "supportType",
          "mode",
          "initialSettings",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "disease": {
            "type": "string",
            "description": "e.g. 'ARDS', 'تشدید حاد COPD'."
          },
          "riskFactors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supportType": {
            "type": "string",
            "description": "e.g. invasive ventilation / BiPAP / NIV contraindicated."
          },
          "indicationNote": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "initialSettings": {
            "type": "object",
            "description": "Any subset of these fields; the renderer only shows the ones present.",
            "properties": {
              "FiO2": {
                "type": "string"
              },
              "PEEP": {
                "type": "string"
              },
              "tidalVolume": {
                "type": "string"
              },
              "respiratoryRate": {
                "type": "string"
              },
              "ipap": {
                "type": "string"
              },
              "epap": {
                "type": "string"
              },
              "other": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "rationale": {
            "type": "string"
          },
          "exampleAbgVbg": {
            "type": "object",
            "properties": {
              "ph": {
                "type": "string"
              },
              "paco2": {
                "type": "string"
              },
              "pao2": {
                "type": "string"
              },
              "hco3": {
                "type": "string"
              },
              "interpretation": {
                "type": "string"
              }
            }
          },
          "titrationSteps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "trigger",
                "action"
              ],
              "properties": {
                "trigger": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                }
              }
            }
          },
          "pitfalls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "$ref": "#/definitions/sourceRefs"
          }
        }
      }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "imageRef": {
      "type": "object",
      "required": [
        "topicId",
        "imageId"
      ],
      "properties": {
        "topicId": {
          "type": "string"
        },
        "imageId": {
          "type": "string"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "sourceId"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "string"
          ]
        },
        "pages": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sourceRef"
      }
    },
    "lessonParagraph": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "sourceRefs": {
          "$ref": "#/definitions/sourceRefs"
        },
        "legacyLoc": {
          "type": "string"
        }
      }
    }
  }
}
