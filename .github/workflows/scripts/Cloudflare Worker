export default {
  async fetch(req, env) {
    if (req.method !== "POST") return new Response("Method Not Allowed", { status: 405 });

    // ۱) احراز هویت ادمین
    const session = req.headers.get("x-admin-session");
    if (!session || session !== env.ADMIN_SESSION_SECRET)
      return new Response("Unauthorized", { status: 401 });

    const { content_id, target_topic, mode, position, requested_by } = await req.json();
    if (!content_id || !target_topic || !mode)
      return new Response("Bad Request", { status: 400 });

    // ۲) فراخوانی workflow_dispatch
    const gh = await fetch(
      `https://api.github.com/repos/${env.OWNER}/${env.REPO}/actions/workflows/publish-content.yml/dispatches`,
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${env.GH_TOKEN}`,
          Accept: "application/vnd.github+json",
          "Content-Type": "application/json",
          "User-Agent": "intmed-publisher"
        },
        body: JSON.stringify({
          ref: "main",
          inputs: { content_id, target_topic, mode, position: position ?? "", requested_by }
        })
      }
    );

    if (!gh.ok) return new Response(await gh.text(), { status: 502 });
    return Response.json({ ok: true, message: "publish triggered" });
  }
};
